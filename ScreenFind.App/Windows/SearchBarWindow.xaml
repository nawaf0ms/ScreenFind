<Window x:Class="ScreenFind.App.Windows.SearchBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenFind.App.Localization"
        Title="ScreenFind"
        Width="560" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <Border Background="{StaticResource BarBackground}"
            BorderBrush="{StaticResource BarBorder}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10,8"
            MouseLeftButtonDown="OnDragArea">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.5" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔍" FontSize="15" Margin="2,0,8,0"
                           VerticalAlignment="Center" Foreground="{StaticResource BarMuted}" />

                <TextBox x:Name="QueryBox" Grid.Column="1"
                         Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource BarForeground}"
                         CaretBrush="{StaticResource BarAccent}"
                         SelectionBrush="{StaticResource BarAccent}"
                         FontSize="15" VerticalContentAlignment="Center"
                         TextChanged="OnQueryChanged" />

                <TextBlock x:Name="CounterText" Grid.Column="2" Text=""
                           Margin="8,0" VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource BarMuted}" />

                <Button x:Name="PreviousButton" Grid.Column="3" Style="{StaticResource IconButton}"
                        Content="‹" ToolTip="{loc:T Bar.Previous}" Click="OnPrevious" />
                <Button x:Name="NextButton" Grid.Column="4" Style="{StaticResource IconButton}"
                        Content="›" ToolTip="{loc:T Bar.Next}" Click="OnNext" />
                <Button Grid.Column="5" Style="{StaticResource IconButton}"
                        Content="✕" ToolTip="{loc:T Bar.Close}" Click="OnClose" />
            </Grid>

            <TextBlock x:Name="StatusText" Margin="26,2,0,0" FontSize="11"
                       Foreground="{StaticResource BarMuted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</Window>
