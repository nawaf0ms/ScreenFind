<Window x:Class="ScreenFind.App.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ScreenFind.App.Localization"
        Title="{loc:T Settings.Title}"
        Width="660" Height="760"
        MinWidth="560" MinHeight="480"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="#FF161618"
        Foreground="{StaticResource BarForeground}"
        FontFamily="Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- BasedOn matters: a keyed style does not inherit the implicit one, and dropping
             TextWrapping is what clips long hints. -->
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource BarAccent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource BarMuted}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <Style x:Key="RowLabel" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <!-- A section card: consistent padding and spacing everywhere. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF202024" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18,16" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF2C2C31" />
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="Swatch" TargetType="Border">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderBrush" Value="#44FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="12,0,0,0" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,8" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- header -->
        <Border DockPanel.Dock="Top" Background="#FF1C1C1F" BorderBrush="#22FFFFFF"
                BorderThickness="0,0,0,1" Padding="22,16">
            <StackPanel>
                <TextBlock Text="{loc:T Settings.Title}" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="{loc:T Settings.Subtitle}" Foreground="{StaticResource BarMuted}"
                           FontSize="12" Margin="0,4,0,0" />
                <TextBlock Margin="0,6,0,0" FontSize="11.5" Foreground="{StaticResource BarMuted}">
                    <Run x:Name="CreditRun" />
                    <Hyperlink NavigateUri="https://github.com/nawaf0ms"
                               RequestNavigate="OnOpenLink"
                               Foreground="{StaticResource BarAccent}"
                               TextDecorations="None">github.com/nawaf0ms</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- footer -->
        <Border DockPanel.Dock="Bottom" Background="#FF1C1C1F" BorderBrush="#22FFFFFF"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Grid.Column="0" Style="{StaticResource Hint}"
                           Margin="0,0,12,0" VerticalAlignment="Center"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{loc:T Settings.Reset}" Click="OnReset" MinWidth="140" />
                    <Button Content="{loc:T Settings.Cancel}" Click="OnCancel" IsCancel="True" />
                    <Button Content="{loc:T Settings.Save}" Click="OnSave" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,22,18">
            <StackPanel>

                <!-- language + hotkey -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Language}" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                       Text="{loc:T Settings.Language.Label}" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Hotkey}" />
                        <TextBox x:Name="HotkeyBox" IsReadOnly="True" FontSize="15" MinHeight="38"
                                 HorizontalContentAlignment="Center"
                                 PreviewKeyDown="OnHotkeyKeyDown" GotFocus="OnHotkeyFocus" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings.Hotkey.Hint}" />
                    </StackPanel>
                </Border>

                <!-- extraction -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Extraction}" />

                        <CheckBox x:Name="UseUiaBox" Content="{loc:T Settings.UseUia}" Margin="0,0,0,14" />

                        <TextBlock Text="{loc:T Settings.OcrLanguages}" Margin="0,0,0,6" />
                        <ContentControl x:Name="LanguageList" Margin="6,0,0,0" />
                        <TextBlock x:Name="LanguageHint" Style="{StaticResource Hint}" Margin="0,8,0,14" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.Scale}" />
                            <ComboBox x:Name="ScaleBox" Grid.Column="1" />
                        </Grid>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.Resample}" />
                            <ComboBox x:Name="ResampleBox" Grid.Column="1" />
                        </Grid>

                        <CheckBox x:Name="GrayscaleBox" Content="{loc:T Settings.Grayscale}" Margin="0" />
                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings.PreprocessHint}" />
                    </StackPanel>
                </Border>

                <!-- matching -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Matching}" />

                        <CheckBox x:Name="FuzzyBox" Content="{loc:T Settings.Fuzzy}" Margin="0,0,0,14"
                                  Checked="OnFuzzyToggled" Unchecked="OnFuzzyToggled" />

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                       Text="{loc:T Settings.MinSimilarity}" />
                            <Slider x:Name="SimilaritySlider" Grid.Column="1" Minimum="0.6" Maximum="1.0"
                                    TickFrequency="0.01" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" ValueChanged="OnSimilarityChanged" />
                            <TextBlock x:Name="SimilarityText" Grid.Column="2" MinWidth="46"
                                       Margin="12,0,0,0" TextAlignment="Center" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}"
                                       Text="{loc:T Settings.MaxResults}" />
                            <ComboBox x:Name="MaxResultsBox" Grid.Column="1" HorizontalAlignment="Stretch" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- colours -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Colors}" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.ColorAll}" />
                            <TextBox x:Name="HighlightColorBox" Grid.Column="1" TextChanged="OnColorChanged" />
                            <Border x:Name="HighlightPreview" Grid.Column="2" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.ColorActive}" />
                            <TextBox x:Name="ActiveColorBox" Grid.Column="1" TextChanged="OnColorChanged" />
                            <Border x:Name="ActivePreview" Grid.Column="2" Style="{StaticResource Swatch}" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.ColorBorder}" />
                            <TextBox x:Name="BorderColorBox" Grid.Column="1" TextChanged="OnColorChanged" />
                            <Border x:Name="BorderPreview" Grid.Column="2" Style="{StaticResource Swatch}" />
                        </Grid>

                        <TextBlock Style="{StaticResource Hint}" Text="{loc:T Settings.ColorHint}" />
                    </StackPanel>
                </Border>

                <!-- behaviour -->
                <Border Style="{StaticResource Card}" Margin="0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{loc:T Settings.Section.Behaviour}" />

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="235" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource RowLabel}" Text="{loc:T Settings.Debounce}" />
                            <ComboBox x:Name="DebounceBox" Grid.Column="1" />
                        </Grid>

                        <CheckBox x:Name="StartupBox" Content="{loc:T Settings.StartWithWindows}" Margin="0" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
