<Application x:Class="ScreenFind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>

        <SolidColorBrush x:Key="BarBackground" Color="#F21E1E20" />
        <SolidColorBrush x:Key="BarBorder" Color="#3AFFFFFF" />
        <SolidColorBrush x:Key="BarForeground" Color="#FFF2F2F2" />
        <SolidColorBrush x:Key="BarMuted" Color="#FF9A9AA0" />
        <SolidColorBrush x:Key="BarAccent" Color="#FFFFB300" />

        <!-- Spec §5.6: all hits in translucent yellow, the active one in orange. -->
        <SolidColorBrush x:Key="HighlightFill" Color="#80FFEB3B" />
        <SolidColorBrush x:Key="ActiveHighlightFill" Color="#B0FF9800" />
        <SolidColorBrush x:Key="ActiveHighlightStroke" Color="#FFE65100" />

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BarForeground}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="28" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#28FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
